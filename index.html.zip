<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ahad Sensi</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  background:#070b12;
  color:#fff;
  font-family:Arial,sans-serif;
}

.container{
  max-width:600px;
  margin:auto;
  padding:18px;
}

.header{
  padding:12px 0 20px;
  font-size:25px;
  font-weight:bold;
}

.card{
  background:#101827;
  border:1px solid #26344b;
  border-radius:20px;
  padding:22px;
  margin-top:15px;
}

.logo{
  width:70px;
  height:70px;
  border-radius:18px;
  background:#243452;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:32px;
  font-weight:bold;
  margin-bottom:18px;
}

h1{
  margin:0 0 8px;
  font-size:28px;
}

.description{
  color:#9eabc0;
  font-size:14px;
}

.price{
  font-size:25px;
  font-weight:bold;
  margin:20px 0;
}

button{
  width:100%;
  border:0;
  border-radius:12px;
  padding:15px;
  background:#2979ff;
  color:white;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
}

button:active{
  transform:scale(.98);
}

.info{
  margin-top:15px;
  padding:13px;
  background:#182338;
  border-radius:11px;
  color:#9eabc0;
  font-size:12px;
  line-height:1.5;
}
</style>
</head>

<body>

<div class="container">

  <div class="header">
    Ahad Sensi
  </div>

  <div class="card">

    <div class="logo">A</div>

    <h1>Ahad Sensi</h1>

    <div class="description">
      Premium APK
    </div>

    <div class="price">
      ৳10
    </div>

    <button onclick="payNow()">
      Pay ৳10 with RupantorPay
    </button>

    <div class="info">
      You will be redirected to the official
      RupantorPay payment page.
    </div>

  </div>

</div>

<script>

/*
==================================================
        RUPANTORPAY CONFIG
==================================================
*/

const RUPANTORPAY_API_KEY =
"cRlKsjIuTzDQcsCZITAXqPSTmhTOIfuJlQk23M1uvwc3Qu5g5k";

const RUPANTORPAY_PAYMENT_LINK =
"https://rupantorpay.com/paymentlink/eyJ1aWQiOjYyNjcsImJyYW5kX2lkIjoiMzg5NSIsImN1c3RvbWVyX2Ftb3VudCI6IjEwIn0";


function payNow(){

    /*
      Opens the REAL RupantorPay payment page.
    */

    window.location.href =
        RUPANTORPAY_PAYMENT_LINK;
}

</script>

</body>
</html>
